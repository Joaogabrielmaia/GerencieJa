<%- include('../../partials/header') %>
<%- include('../../partials/sidebar') %>
<%- include('../../partials/navbar') %>

<main class="ml-64 pt-20 p-8 min-h-screen flex-1 relative z-10">
    <!-- Header Banner -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="text-3xl font-extrabold text-zinc-950 tracking-tight flex items-center gap-3">
                <span>Gestão de Projetos</span>
                <span class="text-xs bg-zinc-950 text-white border border-zinc-950 px-3 py-1 rounded-full font-mono font-medium"><%= projects.length %> Projetos</span>
            </h2>
            <p class="text-zinc-500 text-xs mt-1.5 leading-relaxed">Gerencie o portfólio de produtos, prazos e equipes alocadas.</p>
        </div>

        <button onclick="openNewProjectModal()" class="px-4 py-2.5 bg-zinc-950 text-white hover:bg-zinc-800 rounded-xl text-xs font-semibold shadow-md shadow-zinc-950/15 transition-all flex items-center gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Novo Projeto</span>
        </button>
    </div>

    <!-- Filters & Search Bar -->
    <div class="card-saas p-4 mb-8 flex flex-wrap items-center justify-between gap-4">
        <form action="/projects" method="GET" class="flex flex-wrap items-center gap-3 flex-1">
            <div class="relative min-w-[240px] flex-1">
                <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400"></i>
                <input type="text" name="search" value="<%= search %>" placeholder="Pesquisar por nome, chave..." 
                       class="w-full bg-white border border-zinc-200 rounded-xl pl-9 pr-3 py-2 text-xs text-zinc-950 placeholder-zinc-400 focus:outline-none focus:border-zinc-950">
            </div>

            <select name="category" onchange="this.form.submit()" class="bg-white border border-zinc-200 rounded-xl px-3 py-2 text-xs text-zinc-800 focus:outline-none focus:border-zinc-950">
                <option value="">Todas Categorias</option>
                <option value="Desenvolvimento" <%= category === 'Desenvolvimento' ? 'selected' : '' %>>Desenvolvimento</option>
                <option value="Mobile" <%= category === 'Mobile' ? 'selected' : '' %>>Mobile</option>
                <option value="Design" <%= category === 'Design' ? 'selected' : '' %>>Design</option>
                <option value="Infraestrutura" <%= category === 'Infraestrutura' ? 'selected' : '' %>>Infraestrutura</option>
                <option value="Marketing" <%= category === 'Marketing' ? 'selected' : '' %>>Marketing</option>
            </select>

            <select name="status" onchange="this.form.submit()" class="bg-white border border-zinc-200 rounded-xl px-3 py-2 text-xs text-zinc-800 focus:outline-none focus:border-zinc-950">
                <option value="">Todos Status</option>
                <option value="Em Andamento" <%= status === 'Em Andamento' ? 'selected' : '' %>>Em Andamento</option>
                <option value="Planejamento" <%= status === 'Planejamento' ? 'selected' : '' %>>Planejamento</option>
                <option value="Pausado" <%= status === 'Pausado' ? 'selected' : '' %>>Pausado</option>
                <option value="Concluído" <%= status === 'Concluído' ? 'selected' : '' %>>Concluído</option>
            </select>

            <button type="submit" class="px-3.5 py-2 bg-zinc-100 hover:bg-zinc-200 border border-zinc-300 rounded-xl text-xs font-semibold text-zinc-800">
                Filtrar
            </button>

            <% if (search || category || status) { %>
                <a href="/projects" class="text-xs text-zinc-500 hover:text-rose-600 flex items-center gap-1 font-medium">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i> Limpar
                </a>
            <% } %>
        </form>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(p => { %>
                <div class="card-saas p-6 flex flex-col justify-between relative group">
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-1 rounded-lg bg-zinc-950 text-white font-mono text-xs font-bold shadow-xs">
                                    <%= p.key %>
                                </span>
                                <span class="text-[11px] text-zinc-500 bg-zinc-100 border border-zinc-200 px-2 py-0.5 rounded-full font-medium">
                                    <%= p.category %>
                                </span>
                            </div>

                            <% if (p.status === 'Em Andamento') { %>
                                <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 border border-emerald-500/20 text-[11px] font-bold flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Em Andamento
                                </span>
                            <% } else if (p.status === 'Concluído') { %>
                                <span class="px-2.5 py-0.5 rounded-full bg-sky-500/10 text-sky-700 border border-sky-500/20 text-[11px] font-bold flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span> Concluído
                                </span>
                            <% } else if (p.status === 'Pausado') { %>
                                <span class="px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-700 border border-amber-500/20 text-[11px] font-bold flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pausado
                                </span>
                            <% } else { %>
                                <span class="px-2.5 py-0.5 rounded-full bg-zinc-200 text-zinc-700 border border-zinc-300 text-[11px] font-bold flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span> Planejamento
                                </span>
                            <% } %>
                        </div>

                        <h3 class="font-extrabold text-zinc-950 text-base mb-1.5 hover:text-zinc-700 transition-colors">
                            <a href="/projects/<%= p.id %>"><%= p.name %></a>
                        </h3>
                        <p class="text-xs text-zinc-500 line-clamp-2 mb-5 leading-relaxed">
                            <%= p.description || 'Sem descrição cadastrada.' %>
                        </p>
                    </div>

                    <div>
                        <div class="bg-zinc-50 border border-zinc-200/80 rounded-xl p-3.5 mb-5 space-y-2">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-zinc-500 font-medium">Progresso</span>
                                <span class="font-extrabold text-zinc-950 font-mono">
                                    <%= p.total_tasks > 0 ? Math.round((p.completed_tasks / p.total_tasks) * 100) : 0 %>%
                                </span>
                            </div>
                            <div class="w-full bg-zinc-200 rounded-full h-1.5 overflow-hidden">
                                <div class="bg-zinc-950 h-1.5 rounded-full" style="width: <%= p.total_tasks > 0 ? (p.completed_tasks / p.total_tasks) * 100 : 0 %>%"></div>
                            </div>
                            <div class="flex items-center justify-between text-[11px] text-zinc-500 pt-1 font-medium">
                                <span><i data-lucide="check-circle-2" class="w-3 h-3 inline text-emerald-600 mr-1"></i> <%= p.completed_tasks %> / <%= p.total_tasks %> tarefas</span>
                                <span><i data-lucide="users" class="w-3 h-3 inline text-sky-600 mr-1"></i> <%= p.total_members %> membros</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-3 border-t border-zinc-200/80">
                            <div class="flex items-center gap-2">
                                <% if (p.owner_avatar) { %>
                                    <img src="<%= p.owner_avatar %>" alt="Líder" class="w-6 h-6 rounded-full object-cover border border-zinc-300">
                                <% } else { %>
                                    <div class="w-6 h-6 rounded-full bg-zinc-950 text-white text-[10px] font-bold flex items-center justify-center">
                                        <%= p.owner_name ? p.owner_name.charAt(0) : '?' %>
                                    </div>
                                <% } %>
                                <span class="text-xs font-semibold text-zinc-800 truncate max-w-[110px]"><%= p.owner_name || 'Sem Líder' %></span>
                            </div>

                            <div class="flex items-center gap-1">
                                <button data-project="<%= encodeURIComponent(JSON.stringify(p)) %>" onclick="openEditProjectModal(this)" title="Editar Projeto"
                                        class="p-2 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-700 transition-colors">
                                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                                </button>
                                <button onclick="openDeleteModal(<%= p.id %>, '<%= p.name %>')" title="Excluir Projeto"
                                        class="p-2 rounded-xl bg-zinc-100 hover:bg-rose-100 text-rose-600 transition-colors">
                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                </button>
                                <a href="/projects/<%= p.id %>" title="Abrir Projeto"
                                   class="p-2 rounded-xl bg-zinc-950 text-white hover:bg-zinc-800 text-xs transition-colors ml-1 inline-flex items-center justify-center shadow-xs">
                                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-span-full card-saas p-12 text-center">
                <i data-lucide="folder-open" class="w-10 h-10 text-zinc-400 mx-auto mb-3"></i>
                <h3 class="text-zinc-950 font-bold text-base">Nenhum projeto encontrado</h3>
                <p class="text-xs text-zinc-500 mt-1 max-w-sm mx-auto">Cadastre novos projetos para iniciar a gestão.</p>
                <button onclick="openNewProjectModal()" class="mt-4 px-4 py-2 bg-zinc-950 text-white hover:bg-zinc-800 rounded-xl text-xs font-semibold shadow-md shadow-zinc-950/15">
                    Criar Primeiro Projeto
                </button>
            </div>
        <% } %>
    </div>
</main>

<!-- Edit Project Modal -->
<div id="editProjectModal" class="fixed inset-0 z-50 flex items-center justify-center bg-zinc-950/40 backdrop-blur-md hidden">
    <div class="bg-white border border-zinc-200/90 rounded-2xl w-full max-w-lg p-6 shadow-2xl relative">
        <div class="flex items-center justify-between border-b border-zinc-200/80 pb-4 mb-4">
            <h3 class="font-bold text-zinc-950 text-sm flex items-center gap-2">
                <i data-lucide="edit-3" class="w-4 h-4 text-zinc-500"></i>
                Editar Projeto
            </h3>
            <button onclick="closeEditProjectModal()" class="text-zinc-400 hover:text-zinc-950">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form id="editProjectForm" method="POST" class="space-y-4">
            <div class="grid grid-cols-3 gap-3">
                <div class="col-span-2">
                    <label class="block text-xs font-semibold text-zinc-600 mb-1">Nome do Projeto *</label>
                    <input type="text" id="edit_name" name="name" required
                           class="w-full bg-white border border-zinc-200 rounded-xl px-3 py-2 text-xs text-zinc-950 focus:outline-none focus:border-zinc-950">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-600 mb-1">Chave (KEY) *</label>
                    <input type="text" id="edit_key" name="key" required maxlength="6" style="text-transform: uppercase;"
                           class="w-full bg-white border border-zinc-200 rounded-xl px-3 py-2 text-xs text-zinc-950 uppercase font-mono focus:outline-none focus:border-zinc-950">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-zinc-600 mb-1">Descrição</label>
                <textarea id="edit_description" name="description" rows="2"
                          class="w-full bg-white border border-zinc-200 rounded-xl px-3 py-2 text-xs text-zinc-950 focus:outline-none focus:border-zinc-950"></textarea>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-zinc-600 mb-1">Categoria</label>
                    <select id="edit_category" name="category" class="w-full bg-white border border-zinc-200 rounded-xl px-3 py-2 text-xs text-zinc-950 focus:outline-none focus:border-zinc-950">
                        <option value="Desenvolvimento">Desenvolvimento</option>
                        <option value="Mobile">Mobile</option>
                        <option value="Design">Design</option>
                        <option value="Infraestrutura">Infraestrutura</option>
                        <option value="Marketing">Marketing</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-600 mb-1">Status</label>
                    <select id="edit_status" name="status" class="w-full bg-white border border-zinc-200 rounded-xl px-3 py-2 text-xs text-zinc-950 focus:outline-none focus:border-zinc-950">
                        <option value="Planejamento">Planejamento</option>
                        <option value="Em Andamento">Em Andamento</option>
                        <option value="Pausado">Pausado</option>
                        <option value="Concluído">Concluído</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-zinc-600 mb-1">Líder do Projeto</label>
                    <select id="edit_owner_id" name="owner_id" class="w-full bg-white border border-zinc-200 rounded-xl px-3 py-2 text-xs text-zinc-950 focus:outline-none focus:border-zinc-950">
                        <option value="">Selecione um líder</option>
                        <% teamMembers.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.name %> (<%= m.role %>)</option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-600 mb-1">Data de Término</label>
                    <input type="date" id="edit_end_date" name="end_date" class="w-full bg-white border border-zinc-200 rounded-xl px-3 py-2 text-xs text-zinc-950 focus:outline-none focus:border-zinc-950">
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-zinc-200/80">
                <button type="button" onclick="closeEditProjectModal()" class="px-4 py-2 text-xs font-medium text-zinc-500 hover:text-zinc-950">
                    Cancelar
                </button>
                <button type="submit" class="px-4 py-2 bg-zinc-950 hover:bg-zinc-800 text-white rounded-xl text-xs font-semibold shadow-md shadow-zinc-950/15">
                    Atualizar Projeto
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Project Modal -->
<div id="deleteModal" class="fixed inset-0 z-50 flex items-center justify-center bg-zinc-950/40 backdrop-blur-md hidden">
    <div class="bg-white border border-zinc-200/90 rounded-2xl w-full max-w-md p-6 shadow-2xl text-center">
        <div class="w-12 h-12 rounded-full bg-rose-500/10 text-rose-600 border border-rose-500/20 flex items-center justify-center mx-auto mb-3">
            <i data-lucide="alert-triangle" class="w-5 h-5"></i>
        </div>
        <h3 class="font-extrabold text-zinc-950 text-base">Confirmar Exclusão</h3>
        <p class="text-xs text-zinc-500 mt-1">Tem certeza que deseja excluir o projeto <strong id="deleteProjectName" class="text-zinc-950"></strong>?</p>

        <form id="deleteProjectForm" method="POST" class="flex items-center justify-center gap-3 mt-6">
            <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 text-xs font-semibold text-zinc-600 hover:text-zinc-950 bg-zinc-100 border border-zinc-200 rounded-xl">
                Cancelar
            </button>
            <button type="submit" class="px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white rounded-xl text-xs font-semibold shadow-sm">
                Excluir Projeto
            </button>
        </form>
    </div>
</div>

<script>
    function openEditProjectModal(btnOrProject) {
        let project = btnOrProject;
        if (btnOrProject instanceof HTMLElement) {
            project = JSON.parse(decodeURIComponent(btnOrProject.getAttribute('data-project')));
        }
        document.getElementById('editProjectForm').action = `/projects/${project.id}/update`;
        document.getElementById('edit_name').value = project.name || '';
        document.getElementById('edit_key').value = project.key || '';
        document.getElementById('edit_description').value = project.description || '';
        document.getElementById('edit_category').value = project.category || 'Desenvolvimento';
        document.getElementById('edit_status').value = project.status || 'Em Andamento';
        document.getElementById('edit_owner_id').value = project.owner_id || '';
        document.getElementById('edit_end_date').value = project.end_date || '';
        openModal('editProjectModal');
    }

    function closeEditProjectModal() { closeModal('editProjectModal'); }

    function openDeleteModal(id, name) {
        document.getElementById('deleteProjectForm').action = `/projects/${id}/delete`;
        document.getElementById('deleteProjectName').innerText = name;
        openModal('deleteModal');
    }

    function closeDeleteModal() { closeModal('deleteModal'); }
</script>

<%- include('../../partials/footer') %>
