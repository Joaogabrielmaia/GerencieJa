<%- include('../../partials/header') %>
<%- include('../../partials/sidebar') %>
<%- include('../../partials/navbar') %>

<main class="ml-64 pt-20 p-8 min-h-screen flex-1 relative z-10">
    <!-- Project Header Banner -->
    <div class="card-saas p-6 mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-2xl bg-zinc-950 text-white flex items-center justify-center font-mono font-bold text-lg shadow-md shadow-zinc-950/20 shrink-0">
                    <%= project.key %>
                </div>
                <div>
                    <div class="flex items-center gap-3">
                        <h2 class="text-2xl font-extrabold text-zinc-950 tracking-tight"><%= project.name %></h2>
                        <% if (project.status === 'Em Andamento') { %>
                            <span class="px-3 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 border border-emerald-500/20 text-xs font-bold">Em Andamento</span>
                        <% } else if (project.status === 'Concluído') { %>
                            <span class="px-3 py-0.5 rounded-full bg-sky-500/10 text-sky-700 border border-sky-500/20 text-xs font-bold">Concluído</span>
                        <% } else if (project.status === 'Pausado') { %>
                            <span class="px-3 py-0.5 rounded-full bg-amber-500/10 text-amber-700 border border-amber-500/20 text-xs font-bold">Pausado</span>
                        <% } else { %>
                            <span class="px-3 py-0.5 rounded-full bg-zinc-200 text-zinc-700 border border-zinc-300 text-xs font-bold">Planejamento</span>
                        <% } %>
                    </div>
                    <p class="text-xs text-zinc-500 mt-1 max-w-2xl leading-relaxed"><%= project.description || 'Sem descrição cadastrada.' %></p>
                </div>
            </div>

            <div class="flex items-center gap-3 shrink-0">
                <a href="/projects" class="px-3.5 py-2 bg-zinc-100 hover:bg-zinc-200 border border-zinc-300 rounded-xl text-xs font-semibold text-zinc-800 transition-colors">
                    <i data-lucide="arrow-left" class="w-3.5 h-3.5 inline mr-1"></i> Voltar
                </a>
                <button data-project="<%= encodeURIComponent(JSON.stringify(project)) %>" onclick="openEditProjectModal(this)" class="px-4 py-2 bg-zinc-950 text-white hover:bg-zinc-800 rounded-xl text-xs font-semibold shadow-md shadow-zinc-950/15">
                    <i data-lucide="edit-3" class="w-3.5 h-3.5 inline mr-1"></i> Editar Projeto
                </button>
            </div>
        </div>

        <!-- Navigation Tabs (7 Abas) -->
        <div class="flex items-center gap-2 border-b border-zinc-200/80 mt-6 overflow-x-auto">
            <a href="?tab=resumo" class="px-4 py-2.5 text-xs font-semibold border-b-2 transition-colors whitespace-nowrap flex items-center gap-1.5 <%= activeTab === 'resumo' ? 'border-zinc-950 text-zinc-950 font-bold' : 'border-transparent text-zinc-500 hover:text-zinc-950' %>">
                <i data-lucide="pie-chart" class="w-3.5 h-3.5"></i> Resumo
            </a>
            <a href="?tab=equipe" class="px-4 py-2.5 text-xs font-semibold border-b-2 transition-colors whitespace-nowrap flex items-center gap-1.5 <%= activeTab === 'equipe' ? 'border-zinc-950 text-zinc-950 font-bold' : 'border-transparent text-zinc-500 hover:text-zinc-950' %>">
                <i data-lucide="users" class="w-3.5 h-3.5"></i> Equipe (<%= members.length %>)
            </a>
            <a href="?tab=sprint" class="px-4 py-2.5 text-xs font-semibold border-b-2 transition-colors whitespace-nowrap flex items-center gap-1.5 <%= activeTab === 'sprint' ? 'border-zinc-950 text-zinc-950 font-bold' : 'border-transparent text-zinc-500 hover:text-zinc-950' %>">
                <i data-lucide="zap" class="w-3.5 h-3.5"></i> Sprint Atual
            </a>
            <a href="?tab=backlog" class="px-4 py-2.5 text-xs font-semibold border-b-2 transition-colors whitespace-nowrap flex items-center gap-1.5 <%= activeTab === 'backlog' ? 'border-zinc-950 text-zinc-950 font-bold' : 'border-transparent text-zinc-500 hover:text-zinc-950' %>">
                <i data-lucide="check-square" class="w-3.5 h-3.5"></i> Backlog (<%= backlog.length %>)
            </a>
            <a href="?tab=kpis" class="px-4 py-2.5 text-xs font-semibold border-b-2 transition-colors whitespace-nowrap flex items-center gap-1.5 <%= activeTab === 'kpis' ? 'border-zinc-950 text-zinc-950 font-bold' : 'border-transparent text-zinc-500 hover:text-zinc-950' %>">
                <i data-lucide="line-chart" class="w-3.5 h-3.5"></i> KPIs
            </a>
            <a href="?tab=metas" class="px-4 py-2.5 text-xs font-semibold border-b-2 transition-colors whitespace-nowrap flex items-center gap-1.5 <%= activeTab === 'metas' ? 'border-zinc-950 text-zinc-950 font-bold' : 'border-transparent text-zinc-500 hover:text-zinc-950' %>">
                <i data-lucide="target" class="w-3.5 h-3.5"></i> Metas (<%= goals.length %>)
            </a>
            <a href="?tab=historico" class="px-4 py-2.5 text-xs font-semibold border-b-2 transition-colors whitespace-nowrap flex items-center gap-1.5 <%= activeTab === 'historico' ? 'border-zinc-950 text-zinc-950 font-bold' : 'border-transparent text-zinc-500 hover:text-zinc-950' %>">
                <i data-lucide="history" class="w-3.5 h-3.5"></i> Histórico
            </a>
        </div>
    </div>

    <!-- TAB 1: RESUMO -->
    <% if (activeTab === 'resumo') { %>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 space-y-6">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <div class="card-saas p-4">
                        <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest">Tarefas Totais</span>
                        <p class="text-2xl font-extrabold text-zinc-950 font-mono mt-1"><%= kpis.totalTasks %></p>
                        <span class="text-[10px] text-emerald-600 font-bold"><%= kpis.doneTasks %> Concluídas</span>
                    </div>
                    <div class="card-saas p-4">
                        <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest">Story Points</span>
                        <p class="text-2xl font-extrabold text-zinc-950 font-mono mt-1"><%= kpis.donePoints %> / <%= kpis.totalPoints %></p>
                        <span class="text-[10px] text-sky-600 font-bold"><%= kpis.pointsRate %>% Entregues</span>
                    </div>
                    <div class="card-saas p-4">
                        <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest">Total Sprints</span>
                        <p class="text-2xl font-extrabold text-zinc-950 font-mono mt-1"><%= kpis.totalSprints %></p>
                        <span class="text-[10px] text-amber-600 font-bold"><%= currentSprint ? 'Sprint Ativa' : 'Sem Sprint' %></span>
                    </div>
                    <div class="card-saas p-4">
                        <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest">Equipe</span>
                        <p class="text-2xl font-extrabold text-zinc-950 font-mono mt-1"><%= kpis.totalMembers %></p>
                        <span class="text-[10px] text-zinc-500 font-medium">Membros Alocados</span>
                    </div>
                </div>

                <div class="card-saas p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-bold text-zinc-950 text-base flex items-center gap-2">
                            <i data-lucide="zap" class="w-4 h-4 text-amber-600"></i>
                            Sprint em Execução
                        </h3>
                        <% if (currentSprint) { %>
                            <span class="px-3 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 border border-emerald-500/20 text-xs font-bold">Ativa</span>
                        <% } %>
                    </div>

                    <% if (currentSprint) { %>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <h4 class="font-bold text-zinc-950 text-sm"><%= currentSprint.name %></h4>
                                <span class="text-xs text-zinc-500 font-mono font-medium">
                                    <%= formatDate(currentSprint.start_date) %> à <%= formatDate(currentSprint.end_date) %>
                                </span>
                            </div>
                            <p class="text-xs text-zinc-600 bg-zinc-50 p-3.5 rounded-xl border border-zinc-200">
                                🎯 <strong>Objetivo:</strong> <%= currentSprint.goal %>
                            </p>
                        </div>
                    <% } else { %>
                        <p class="text-xs text-zinc-500">Nenhuma sprint ativa no momento.</p>
                    <% } %>
                </div>
            </div>

            <div class="space-y-6">
                <div class="card-saas p-6 space-y-4">
                    <h3 class="font-bold text-zinc-950 text-sm border-b border-zinc-200/80 pb-3">Detalhes do Projeto</h3>

                    <div>
                        <span class="text-xs font-semibold text-zinc-400">Líder do Projeto</span>
                        <div class="flex items-center gap-3 mt-1.5">
                            <% if (project.owner_avatar) { %>
                                <img src="<%= project.owner_avatar %>" class="w-8 h-8 rounded-full border border-zinc-300">
                            <% } else { %>
                                <div class="w-8 h-8 rounded-full bg-zinc-950 text-white font-bold text-xs flex items-center justify-center">
                                    <%= project.owner_name ? project.owner_name.charAt(0) : '?' %>
                                </div>
                            <% } %>
                            <div>
                                <p class="text-xs font-bold text-zinc-950"><%= project.owner_name || 'Não atribuído' %></p>
                                <p class="text-[10px] text-zinc-500"><%= project.owner_role || 'Líder' %></p>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 pt-2">
                        <div>
                            <span class="text-xs font-semibold text-zinc-400">Data de Início</span>
                            <p class="text-xs font-bold text-zinc-950 mt-1"><%= formatDate(project.start_date) %></p>
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-zinc-400">Previsão Término</span>
                            <p class="text-xs font-bold text-zinc-950 mt-1"><%= formatDate(project.end_date) %></p>
                        </div>
                    </div>

                    <div class="pt-2">
                        <span class="text-xs font-semibold text-zinc-400">Categoria</span>
                        <p class="text-xs font-bold text-zinc-950 mt-1"><%= project.category %></p>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- TAB 2: EQUIPE -->
    <% if (activeTab === 'equipe') { %>
        <div class="card-saas p-6">
            <h3 class="font-bold text-zinc-950 text-base mb-6">Membros Alocados no Projeto</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <% if (members && members.length > 0) { %>
                    <% members.forEach(m => { %>
                        <div class="bg-zinc-50 border border-zinc-200/80 rounded-xl p-4 flex items-center gap-4">
                            <img src="<%= m.avatar_url %>" alt="<%= m.name %>" class="w-11 h-11 rounded-full object-cover border border-zinc-300">
                            <div>
                                <h4 class="font-bold text-zinc-950 text-sm"><%= m.name %></h4>
                                <p class="text-xs text-zinc-600 font-medium"><%= m.assigned_role || m.role %></p>
                                <p class="text-[11px] text-zinc-400 mt-0.5"><%= m.email %></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-xs text-zinc-500 col-span-full py-6 text-center">Nenhum membro alocado neste projeto ainda.</p>
                <% } %>
            </div>
        </div>
    <% } %>

    <!-- TAB 3: SPRINT ATUAL -->
    <% if (activeTab === 'sprint') { %>
        <div class="card-saas p-6">
            <% if (currentSprint) { %>
                <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-zinc-200/80">
                    <div>
                        <div class="flex items-center gap-3">
                            <h3 class="font-bold text-zinc-950 text-lg"><%= currentSprint.name %></h3>
                            <span class="px-3 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 border border-emerald-500/20 text-xs font-bold">Sprint Ativa</span>
                        </div>
                        <p class="text-xs text-zinc-500 mt-1">Meta: <%= currentSprint.goal %></p>
                    </div>

                    <div class="text-right">
                        <span class="text-xs text-zinc-400">Período</span>
                        <p class="text-xs font-mono font-bold text-zinc-950">
                            <%= formatDate(currentSprint.start_date) %> - <%= formatDate(currentSprint.end_date) %>
                        </p>
                    </div>
                </div>

                <h4 class="font-bold text-zinc-950 text-sm mb-4">Tarefas da Sprint</h4>
                <div class="space-y-3">
                    <% const sprintTasks = backlog.filter(t => t.sprint_id === currentSprint.id); %>
                    <% if (sprintTasks.length > 0) { %>
                        <% sprintTasks.forEach(t => { %>
                            <div class="bg-zinc-50 border border-zinc-200/80 rounded-xl p-3.5 flex items-center justify-between text-xs">
                                <div class="flex items-center gap-3">
                                    <span class="px-2 py-0.5 rounded bg-zinc-950 text-white font-bold font-mono text-[10px]"><%= t.story_points %> pts</span>
                                    <span class="font-bold text-zinc-950"><%= t.title %></span>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="text-zinc-500"><%= t.assignee_name || 'Sem responsável' %></span>
                                    <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-white border border-zinc-200 text-zinc-800"><%= t.status %></span>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            <% } else { %>
                <div class="text-center py-12">
                    <i data-lucide="zap" class="w-10 h-10 text-zinc-400 mx-auto mb-3"></i>
                    <h3 class="text-zinc-950 font-bold text-base">Nenhuma Sprint Ativa</h3>
                    <p class="text-xs text-zinc-500 mt-1">Crie ou ative uma sprint no módulo de sprints.</p>
                </div>
            <% } %>
        </div>
    <% } %>

    <!-- TAB 4: BACKLOG -->
    <% if (activeTab === 'backlog') { %>
        <div class="card-saas p-6">
            <h3 class="font-bold text-zinc-950 text-base mb-6">Backlog do Projeto</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-zinc-700">
                    <thead class="bg-zinc-100 text-zinc-500 uppercase font-bold text-[10px] tracking-wider border-b border-zinc-200/80">
                        <tr>
                            <th class="py-3 px-4">Pontos</th>
                            <th class="py-3 px-4">Título da Tarefa</th>
                            <th class="py-3 px-4">Prioridade</th>
                            <th class="py-3 px-4">Status</th>
                            <th class="py-3 px-4">Sprint</th>
                            <th class="py-3 px-4">Responsável</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200/60">
                        <% if (backlog && backlog.length > 0) { %>
                            <% backlog.forEach(t => { %>
                                <tr class="hover:bg-zinc-50">
                                    <td class="py-3.5 px-4 font-mono font-bold text-zinc-950"><%= t.story_points %> pts</td>
                                    <td class="py-3.5 px-4 font-bold text-zinc-950"><%= t.title %></td>
                                    <td class="py-3.5 px-4">
                                        <% if (t.priority === 'Urgente') { %>
                                            <span class="text-rose-600 font-bold">Urgente</span>
                                        <% } else if (t.priority === 'Alta') { %>
                                            <span class="text-amber-600 font-bold">Alta</span>
                                        <% } else { %>
                                            <span class="text-zinc-500"><%= t.priority %></span>
                                        <% } %>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-zinc-100 border border-zinc-200 text-zinc-800"><%= t.status %></span>
                                    </td>
                                    <td class="py-3.5 px-4 text-zinc-500"><%= t.sprint_name || 'Backlog Geral' %></td>
                                    <td class="py-3.5 px-4 text-zinc-700 font-medium"><%= t.assignee_name || 'Não atribuído' %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>

    <!-- TAB 5: KPIS -->
    <% if (activeTab === 'kpis') { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="card-saas p-6 space-y-4">
                <h3 class="font-bold text-zinc-950 text-base">Taxa de Conclusão de Tarefas</h3>
                <div class="flex items-baseline gap-2">
                    <span class="text-4xl font-extrabold text-emerald-600 font-mono"><%= kpis.completionRate %>%</span>
                    <span class="text-xs text-zinc-500 font-medium">(<%= kpis.doneTasks %> de <%= kpis.totalTasks %> tarefas)</span>
                </div>
                <div class="w-full bg-zinc-100 rounded-full h-2.5 overflow-hidden">
                    <div class="bg-emerald-500 h-2.5 rounded-full" style="width: <%= kpis.completionRate %>%"></div>
                </div>
            </div>

            <div class="card-saas p-6 space-y-4">
                <h3 class="font-bold text-zinc-950 text-base">Entrega de Story Points</h3>
                <div class="flex items-baseline gap-2">
                    <span class="text-4xl font-extrabold text-sky-600 font-mono"><%= kpis.pointsRate %>%</span>
                    <span class="text-xs text-zinc-500 font-medium">(<%= kpis.donePoints %> de <%= kpis.totalPoints %> pts)</span>
                </div>
                <div class="w-full bg-zinc-100 rounded-full h-2.5 overflow-hidden">
                    <div class="bg-sky-500 h-2.5 rounded-full" style="width: <%= kpis.pointsRate %>%"></div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- TAB 6: METAS -->
    <% if (activeTab === 'metas') { %>
        <div class="card-saas p-6 space-y-4">
            <h3 class="font-bold text-zinc-950 text-base">Metas e OKRs do Projeto</h3>
            <div class="space-y-4">
                <% if (goals && goals.length > 0) { %>
                    <% goals.forEach(g => { %>
                        <% const progressPct = (g.target_value && g.target_value > 0) ? Math.min(100, Math.round((g.current_value / g.target_value) * 100)) : 0; %>
                        <div class="bg-zinc-50 border border-zinc-200/80 rounded-xl p-4 space-y-2">
                            <div class="flex items-center justify-between">
                                <h4 class="font-bold text-zinc-950 text-sm"><%= g.title %></h4>
                                <span class="text-xs font-mono font-bold text-zinc-950"><%= g.current_value %> / <%= g.target_value %> <%= g.unit %></span>
                            </div>
                            <p class="text-xs text-zinc-500"><%= g.description %></p>
                            <div class="w-full bg-zinc-200 rounded-full h-2 overflow-hidden">
                                <div class="bg-zinc-950 h-2 rounded-full" style="width: <%= progressPct %>%"></div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-xs text-zinc-500 text-center py-6">Nenhuma meta cadastrada para este projeto.</p>
                <% } %>
            </div>
        </div>
    <% } %>

    <!-- TAB 7: HISTÓRICO -->
    <% if (activeTab === 'historico') { %>
        <div class="card-saas p-6">
            <h3 class="font-bold text-zinc-950 text-base mb-6">Histórico de Alterações</h3>
            <div class="space-y-4">
                <% if (history && history.length > 0) { %>
                    <% history.forEach(h => { %>
                        <div class="flex gap-4 items-start border-b border-zinc-200/70 pb-3.5 last:border-0 text-xs">
                            <div class="w-7 h-7 rounded-xl bg-zinc-950 text-white flex items-center justify-center shrink-0 mt-0.5">
                                <i data-lucide="info" class="w-3.5 h-3.5"></i>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center justify-between">
                                    <span class="font-bold text-zinc-950"><%= h.action %></span>
                                    <span class="text-[10px] text-zinc-400 font-mono"><%= formatDateTime(h.created_at) %></span>
                                </div>
                                <p class="text-zinc-600 mt-1 leading-relaxed"><%= h.details %></p>
                                <span class="text-[10px] text-zinc-400 mt-0.5 block font-medium">Por: <%= h.user_name %></span>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    <% } %>
</main>

<%- include('../../partials/footer') %>
