<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/navbar') %>

<main class="ml-64 pt-16 p-8 min-h-screen flex-1 bg-zinc-950 flex items-center justify-center">
    <div class="card-saas p-10 max-w-md text-center shadow-2xl relative">
        <div class="w-14 h-14 rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/20 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="alert-circle" class="w-6 h-6"></i>
        </div>

        <h2 class="text-xl font-bold text-zinc-100 tracking-tight"><%= typeof title !== 'undefined' ? title : 'Aviso do Sistema' %></h2>
        <p class="text-xs text-zinc-400 mt-2 leading-relaxed">
            <%= typeof message !== 'undefined' ? message : 'Ocorreu um erro ao processar sua requisição.' %>
        </p>

        <div class="mt-6 pt-4 border-t border-zinc-800 flex items-center justify-center gap-3">
            <button onclick="window.history.back()" class="px-4 py-2 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded-lg text-xs font-medium text-zinc-300 transition-colors">
                Voltar Página
            </button>
            <a href="/" class="px-4 py-2 bg-white hover:bg-zinc-200 text-zinc-950 rounded-lg text-xs font-semibold shadow-sm transition-all">
                Ir para o Dashboard
            </a>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
